<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="GUI_LOG" class="com.kelmy.mediaarchiver.ui.gui.GuiLogAppender" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="GUI_LOG" />
    </root>
</configuration>